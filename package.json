    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "design-tokens",
    "ui",
    "button",
    "andm-ui"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsushi316/andm-ui.git"
  }
