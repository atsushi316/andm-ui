{
  "name": "@atsushi316/andm-ui",
  "version": "0.1.0",
  "description": "CSS-first UI library: Design Tokens and Native HTML components",
  "type": "module",
  "style": "./dist/style.css",
  "exports": {
    "./style.css": "./dist/style.css",
    "./icons.svg": "./dist/icons.svg"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md",
    "docs/EXPERIENCE.md",
    "docs/COMPONENT-SOURCES.md",
    "docs/GALLERY-REVIEW.md",
    "docs/ATOMIC-SOURCES.md",
    "docs/ATOMIC-INVENTORY.md",
    "docs/COMPOSITION-SOURCES.md"
  ],
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "start": "node scripts/gallery.mjs",
    "gallery": "node scripts/gallery.mjs",
    "prepublishOnly": "npm run build",
    "audit:tokens": "npm run build && node scripts/audit-tokens.mjs"
  },
  "keywords": [
    "css",
    "design-tokens",
    "ui",
    "button",
    "textfield",
    "andm-ui"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsushi316/andm-ui.git"
  }
}
