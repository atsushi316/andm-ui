{
  "name": "@atsushi316/andm-ui",
  "version": "0.1.0",
  "description": "CSS-first UI library: Design Tokens and Native HTML components",
  "type": "module",
  "style": "./dist/style.css",
  "exports": {
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
